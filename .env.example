# Copy this file to .env and fill in your values
SECRET_KEY=your-very-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (leave blank to use SQLite)
# DB_NAME=schoolsaas_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# PhonePe (Merchant API)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_API_URL=https://api-preprod.phonepe.com/apis/hermes/pg/v1/pay

# Binance Pay
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_URL=https://bpay.binanceapi.com/binancepay/openapi/v2/order
